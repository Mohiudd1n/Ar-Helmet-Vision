# Cache rules for Netlify / Cloudflare Pages (other hosts: apply the same Cache-Control values).
/models/*
  Cache-Control: public, max-age=604800
/helmet-hero.png
  Cache-Control: public, max-age=604800
/mediapipe/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
